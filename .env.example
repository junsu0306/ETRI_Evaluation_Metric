# Copy this file to .env. Keep machine-specific values out of Git.
# Select a free physical GPU on your machine; it becomes logical cuda:0.
CUDA_VISIBLE_DEVICES=2
# Leave paths unset to use defaults relative to the repository root:
# PITTSBURGH_ROOT: data/datasets/pittsburgh
# RUNS_ROOT: artifacts/runs
# CACHE_ROOT: artifacts/cache
# CENTROIDS_ROOT: artifacts/centroids
# Run commands from the repository root for this relative Torch cache path.
TORCH_HOME=./artifacts/torch

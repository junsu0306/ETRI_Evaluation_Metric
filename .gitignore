# Public submission: only these root entries are versioned.
/*
!/.gitignore
!/.env.example
!/README.md
!/pyproject.toml
!/requirements.txt
!/src/
!/scripts/
!/tests/
!/docs/
!/results/

# Runtime data is root-scoped: src/robot_compression/data IS source code.
/data/
/artifacts/
/trash/
/.env
/.env.*
!/.env.example
/.venv/
/AGENTS.md
/RULE.md
/.agents/
/.codex/
/.aws/

# Only the maintained public documentation is published.
/docs/*
!/docs/ARCHITECTURE.md
!/docs/DATASET.md
!/docs/METHOD.md
!/docs/RESULTS.md
!/docs/REPRODUCING.md
!/docs/VALIDATION.md

# Results contain curated CSV/JSON evidence, never weights or raw logs.
/results/*
!/results/final_comparison.csv
!/results/kd_ablation.csv
!/results/provenance.json
!/results/epochs/
!/results/configs/
!/results/evaluations/

# Generated files, caches, credentials and binary experiment artifacts.
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.env
*.pem
*.key
*.pt
*.pth
*.pth.tar
*.ckpt
*.onnx
*.hdf5
*.h5
*.mat
*.tar
*.tar.gz
*.zip
*.log
*.out
*.err
events.out.tfevents.*
*.part
*.tmp
.coverage*
htmlcov/
build/
dist/
.DS_Store
*.swp
*~
